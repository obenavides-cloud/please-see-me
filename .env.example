# Aplicación
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# RunPod: mantener estos valores solo en .env local/servidor
RUNPOD_API_KEY=
RUNPOD_POD_ID=
RUNPOD_BILLING_APPROVED=false
RUNPOD_GPU_RATE_USD=0.71
RUNPOD_MAX_BUDGET_USD=6
RUNPOD_AUTO_STOP_TOKEN=

# ComfyUI: URL accesible desde el backend (por ejemplo, proxy del Pod)
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_API_KEY=
